# Every ${VAR} in framework/resources/config/environment_config.json resolves
# from .env, which is git-ignored. Placeholders only — the repo is PUBLIC.
#
# Copy this file to .env and fill in what you need. A variable with a default can
# be left blank or deleted. A variable marked REQUIRED has no default: leaving it
# unset fails the run with "<NAME> is not set; set it in .env".
#
# Comments MUST stay on their own line. python-dotenv does not strip a trailing
# comment from an unquoted value — `FOO=bar # note` sets FOO to "bar # note".

# --- Which device_location each platform uses -------------------------------------------
# local | ci | remote | cloud
# /kernel/domain-setup step 1 sets these after probing the host. Setting them by
# hand is the supported override and skips the question entirely.
# default: local
MOBILE_DEVICE_LOCATION_IOS=
# default: local
MOBILE_DEVICE_LOCATION_ANDROID=

# --- The app under test --------------------------------------------------------
# default: apps/SauceLabs-Demo-App.app
IOS_APP_PATH=
# REQUIRED only when launching an already-installed iOS app (no path given)
IOS_BUNDLE_ID=
# REQUIRED for ios + cloud — provider reference, e.g. bs://<hash>
CLOUD_IOS_APP=
# REQUIRED for android + cloud
CLOUD_ANDROID_APP=
# REQUIRED for the hybrid app on ios + cloud
CLOUD_IOS_HYBRID_APP=
# REQUIRED for the hybrid app on android + cloud
CLOUD_ANDROID_HYBRID_APP=

# --- Devices -------------------------------------------------------------------
# REQUIRED for android + remote
ANDROID_UDID=
# REQUIRED for ios + remote and ios + ci
IOS_UDID=
# default: iPhone 15
IOS_DEVICE_NAME=
# default: 18
IOS_PLATFORM_VERSION=
# default: mobileqa_api34
ANDROID_DEVICE_NAME=
# default: 14
ANDROID_PLATFORM_VERSION=

# --- Appium endpoints ----------------------------------------------------------
# REQUIRED for ios + remote
IOS_DEVICE_APPIUM_URL=
# default: http://127.0.0.1:4723
ANDROID_APPIUM_URL=
# default: https://hub-cloud.browserstack.com/wd/hub
CLOUD_HUB_URL=

# --- Cloud credentials ---------------------------------------------------------
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
